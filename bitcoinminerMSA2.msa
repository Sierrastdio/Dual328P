; ========================================
; [PAGE 30-39: MESSAGE SCHEDULE W[0-63]]
; Prepared message blocks for hashing
; ========================================
SETPAGE 30

; W[0] through W[15] come directly from block header
; Copy from Page 0-9

LOAD 0
SLOT 15         ; Index counter

COPY_MESSAGE:
; Fetch from block header
SETPAGE 0
FETCH 15
PUSH

SETPAGE 30
POP
FETCH 15        ; Store in W array
SLOT 0

; Increment counter
FETCH 15
ADD 1
SLOT 15

; Check if copied 16 words (128 nibbles)
LOAD 128
SUB 15
; (Loop back if not done)

; ========================================
; W[16] through W[63] are computed
; ========================================
SETPAGE 31

; W[i] = σ1(W[i-2]) + W[i-7] + σ0(W[i-15]) + W[i-16]
; Where:
; σ0(x) = ROTR(x,7) XOR ROTR(x,18) XOR SHR(x,3)
; σ1(x) = ROTR(x,17) XOR ROTR(x,19) XOR SHR(x,10)

LOAD 16
SLOT 15         ; Start at W[16]

EXPAND_MESSAGE:
; Get W[i-15]
FETCH 15
LOAD 15
SUB 0           ; i - 15
SLOT 14         ; Index

SETPAGE 30
FETCH 14        ; W[i-15]
SLOT 13         ; Temp storage

; ========================================
; SIGMA0 CALCULATION
; ========================================
SETPAGE 80      ; Bit manipulation functions page

; Input in Slot 13
FETCH 13
SLOT 0          ; x = W[i-15]

; ROTR(x, 7) simulation using bit masking
; Split into nibbles, rotate, recombine
FETCH 0
AND 15          ; Lower 4 bits
SLOT 1

FETCH 0
; Shift right (divide by 16 = shift 4 bits)
LOAD 0
SLOT 2          ; Upper bits

; Rotate: combine shifted parts
FETCH 1
; (rotation logic)
SLOT 3          ; ROTR result 1

; ROTR(x, 18) 
FETCH 0
; (similar rotation)
SLOT 4          ; ROTR result 2

; SHR(x, 3)
FETCH 0
; Shift right 3 bits (divide by 8)
LOAD 0
SLOT 5          ; SHR result

; XOR all three (simulated with AND/OR)
FETCH 3
PUSH
FETCH 4
POP
; XOR simulation: (a OR b) AND NOT(a AND b)
OR 4
SLOT 6          ; Temp XOR

FETCH 3
AND 4
LOAD 15
SUB 0           ; NOT
SLOT 7

FETCH 6
AND 7
SLOT 8          ; XOR of first two

; XOR with third
FETCH 8
FETCH 5
OR 5
SLOT 9
FETCH 8
AND 5
LOAD 15
SUB 0
SLOT 10
FETCH 9
AND 10
SLOT 11         ; σ0 result

; ========================================
; SIGMA1 CALCULATION
; ========================================
SETPAGE 81

; Get W[i-2]
SETPAGE 31
FETCH 15
LOAD 2
SUB 0
SLOT 14

SETPAGE 30
FETCH 14
SLOT 13         ; W[i-2]

SETPAGE 81
FETCH 13
SLOT 0

; ROTR(x, 17)
; (similar bit manipulation)
SLOT 1

; ROTR(x, 19)
SLOT 2

; SHR(x, 10)
SLOT 3

; XOR all three
; (similar XOR logic as sigma0)
SLOT 4          ; σ1 result

; ========================================
; COMPUTE W[i]
; ========================================
SETPAGE 31

; W[i] = σ1 + W[i-7] + σ0 + W[i-16]

; Get σ1 result
SETPAGE 81
FETCH 4
PUSH

; Get W[i-7]
SETPAGE 31
FETCH 15
LOAD 7
SUB 0
SLOT 14

SETPAGE 30
FETCH 14
PUSH

; Get σ0 result
SETPAGE 80
FETCH 11
PUSH

; Get W[i-16]
SETPAGE 31
FETCH 15
LOAD 16
SUB 0
SLOT 14

SETPAGE 30
FETCH 14
PUSH

; Sum all four values
SETPAGE 31
POP             ; W[i-16]
SLOT 0
POP             ; σ0
ADD 0
SLOT 0
POP             ; W[i-7]
ADD 0
SLOT 0
POP             ; σ1
ADD 0
SLOT 0

; Store as W[i]
FETCH 0
SETPAGE 30
FETCH 15        ; Current i
SLOT 0

; Next i
SETPAGE 31
FETCH 15
ADD 1
SLOT 15

; Check if done (i < 64)
LOAD 64
SUB 15
; (Loop back if not done)

; ========================================
; [PAGE 40-49: SHA-256 COMPRESSION]
; Main hashing rounds (64 iterations)
; ========================================
SETPAGE 40

; Initialize working variables a-h from H[0-7]
SETPAGE 20
FETCH 0         ; H[0]
SETPAGE 40
SLOT 0          ; a = H[0]

SETPAGE 20
FETCH 8         ; H[1]
SETPAGE 40
SLOT 1          ; b = H[1]

; (Continue for c, d, e, f, g, h)
SETPAGE 21
FETCH 0
SETPAGE 40
SLOT 2          ; c = H[2]

SETPAGE 21
FETCH 8
SETPAGE 40
SLOT 3          ; d = H[3]

SETPAGE 22
FETCH 0
SETPAGE 40
SLOT 4          ; e = H[4]

SETPAGE 22
FETCH 8
SETPAGE 40
SLOT 5          ; f = H[5]

SETPAGE 23
FETCH 0
SETPAGE 40
SLOT 6          ; g = H[6]

SETPAGE 23
FETCH 8
SETPAGE 40
SLOT 7          ; h = H[7]

; ========================================
; COMPRESSION ROUNDS (0 to 63)
; ========================================
SETPAGE 50

LOAD 0
SLOT 15         ; Round counter

COMPRESS_ROUND:

; ========================================
; Calculate T1 = h + Σ1(e) + Ch(e,f,g) + K[i] + W[i]
; ========================================

; Get h
SETPAGE 40
FETCH 7
PUSH

; ========================================
; Σ1(e) = ROTR(e,6) XOR ROTR(e,11) XOR ROTR(e,25)
; ========================================
SETPAGE 82      ; Big Sigma functions

SETPAGE 40
FETCH 4         ; e
SETPAGE 82
SLOT 0

; ROTR(e, 6)
FETCH 0
; (rotation logic)
SLOT 1

; ROTR(e, 11)
FETCH 0
; (rotation logic)
SLOT 2

; ROTR(e, 25)
FETCH 0
; (rotation logic)
SLOT 3

; XOR all three
; (XOR logic)
SLOT 4          ; Σ1(e) result

PUSH

; ========================================
; Ch(e,f,g) = (e AND f) XOR (NOT e AND g)
; ========================================
SETPAGE 83      ; Choice function

SETPAGE 40
FETCH 4         ; e
FETCH 5         ; f
FETCH 6         ; g

SETPAGE 83
SLOT 0          ; e
SLOT 1          ; f
SLOT 2          ; g

; e AND f
FETCH 0
AND 1
SLOT 3

; NOT e
FETCH 0
LOAD 15
SUB 0
SLOT 4

; NOT e AND g
FETCH 4
AND 2
SLOT 5

; XOR the two parts
FETCH 3
FETCH 5
; (XOR logic)
SLOT 6          ; Ch result

PUSH

; ========================================
; Get K[i]
; ========================================
SETPAGE 50
FETCH 15        ; Round number
SLOT 14

; Calculate K page and slot
; K is stored in pages 10-19
FETCH 14
; Divide by 16 to get page offset
LOAD 0
SLOT 13         ; Page calculation

LOAD 10
ADD 13          ; Base page 10 + offset
; SETPAGE (calculated)

FETCH 14
AND 15          ; Modulo 16 for slot
; FETCH (K value)
PUSH

; ========================================
; Get W[i]
; ========================================
SETPAGE 30
FETCH 14        ; W[i]
PUSH

; ========================================
; Sum all components for T1
; ========================================
SETPAGE 50

POP             ; W[i]
SLOT 10
POP             ; K[i]
ADD 10
SLOT 10
POP             ; Ch
ADD 10
SLOT 10
POP             ; Σ1
ADD 10
SLOT 10
POP             ; h
ADD 10
SLOT 10         ; T1 complete

; ========================================
; Calculate T2 = Σ0(a) + Maj(a,b,c)
; ========================================

; ========================================
; Σ0(a) = ROTR(a,2) XOR ROTR(a,13) XOR ROTR(a,22)
; ========================================
SETPAGE 84

SETPAGE 40
FETCH 0         ; a
SETPAGE 84
SLOT 0

; ROTR(a, 2)
FETCH 0
; (rotation)
SLOT 1

; ROTR(a, 13)
FETCH 0
; (rotation)
SLOT 2

; ROTR(a, 22)
FETCH 0
; (rotation)
SLOT 3

; XOR all three
; (XOR logic)
SLOT 4          ; Σ0 result

PUSH

; ========================================
; Maj(a,b,c) = (a AND b) XOR (a AND c) XOR (b AND c)
; ========================================
SETPAGE 85

SETPAGE 40
FETCH 0         ; a
FETCH 1         ; b
FETCH 2         ; c

SETPAGE 85
SLOT 0
SLOT 1
SLOT 2

; a AND b
FETCH 0
AND 1
SLOT 3

; a AND c
FETCH 0
AND 2
SLOT 4

; b AND c
FETCH 1
AND 2
SLOT 5

; XOR all three
; (XOR logic)
SLOT 6          ; Maj result

PUSH

; ========================================
; Sum for T2
; ========================================
SETPAGE 50

POP             ; Maj
SLOT 11
POP             ; Σ0
ADD 11
SLOT 11         ; T2 complete

; ========================================
; UPDATE WORKING VARIABLES
; ========================================
SETPAGE 40

; h = g
FETCH 6
SLOT 7

; g = f
FETCH 5
SLOT 6

; f = e
FETCH 4
SLOT 5

; e = d + T1
FETCH 3
SETPAGE 50
FETCH 10        ; T1
SETPAGE 40
ADD 3
SLOT 4

; d = c
FETCH 2
SLOT 3

; c = b
FETCH 1
SLOT 2

; b = a
FETCH 0
SLOT 1

; a = T1 + T2
SETPAGE 50
FETCH 10        ; T1
FETCH 11        ; T2
ADD 10
SETPAGE 40
SLOT 0

; ========================================
; Next round
; ========================================
SETPAGE 50
FETCH 15
ADD 1
SLOT 15

; Check if all 64 rounds done
LOAD 64
SUB 15
; (Loop back to COMPRESS_ROUND if not done)

; ========================================
; [PAGE 60-69: FINALIZE HASH]
; Add working vars to initial hash
; ========================================
SETPAGE 60

; H[0] = H[0] + a
SETPAGE 20
FETCH 0
PUSH
SETPAGE 40
FETCH 0
POP
ADD 0
SETPAGE 60
SLOT 0          ; New H[0]

; H[1] = H[1] + b
SETPAGE 20
FETCH 8
PUSH
SETPAGE 40
FETCH 1
POP
ADD 0
SETPAGE 60
SLOT 1

; (Continue for H[2] through H[7])
; H[2] = H[2] + c
SETPAGE 21
FETCH 0
PUSH
SETPAGE 40
FETCH 2
POP
ADD 0
SETPAGE 60
SLOT 2

; H[3] = H[3] + d
SETPAGE 21
FETCH 8
PUSH
SETPAGE 40
FETCH 3
POP
ADD 0
SETPAGE 60
SLOT 3

; H[4] = H[4] + e
SETPAGE 22
FETCH 0
PUSH
SETPAGE 40
FETCH 4
POP
ADD 0
SETPAGE 60
SLOT 4

; H[5] = H[5] + f
SETPAGE 22
FETCH 8
PUSH
SETPAGE 40
FETCH 5
POP
ADD 0
SETPAGE 60
SLOT 5

; H[6] = H[6] + g
SETPAGE 23
FETCH 0
PUSH
SETPAGE 40
FETCH 6
POP
ADD 0
SETPAGE 60
SLOT 6

; H[7] = H[7] + h
SETPAGE 23
FETCH 8
PUSH
SETPAGE 40
FETCH 7
POP
ADD 0
SETPAGE 60
SLOT 7

; ========================================
; [PAGE 96-110: MINING LOOP]
; Increment nonce and check if hash is valid
; ========================================
SETPAGE 96

; Initialize nonce counter
LOAD 0
SLOT 0          ; Nonce byte 0
SLOT 1          ; Nonce byte 1
SLOT 2          ; Nonce byte 2
SLOT 3          ; Nonce byte 3

MINING_LOOP:

; ========================================
; Update nonce in block header
; ========================================
FETCH 0
SETPAGE 9
SLOT 0
SETPAGE 96
FETCH 1
SETPAGE 9
SLOT 1
SETPAGE 96
FETCH 2
SETPAGE 9
SLOT 2
SETPAGE 96
FETCH 3
SETPAGE 9
SLOT 3

; ========================================
; Run SHA-256 on current block
; ========================================
; (Call all previous pages)
; Reset to Page 30 for message schedule
; Then Page 40 for compression
; Then Page 60 for finalization

; ========================================
; Check if hash meets difficulty target
; Target: Hash must start with certain number of zeros
; For Block #125552: First 10 nibbles must be 0
; ========================================
SETPAGE 111     ; Validation page

SETPAGE 60
FETCH 0         ; First nibble of hash
SETPAGE 111
LOAD 0
SUB 0           ; Compare with 0
; (if not zero, increment nonce)

SETPAGE 60
FETCH 1         ; Second nibble
SETPAGE 111
LOAD 0
SUB 0
; (if not zero, increment nonce)

; Check first 10 nibbles...
; (Continue for nibbles 2-9)

; If all zeros, we found valid block!
SETPAGE 120
LOAD 1
SLOT 15         ; Success flag
; (Jump to output)

; ========================================
; Increment nonce
; ========================================
INCREMENT_NONCE:
SETPAGE 96

FETCH 0
ADD 1
SLOT 0

; Check overflow
LOAD 0
SUB 0
; (if overflowed, increment next byte)

FETCH 1
ADD 1
SLOT 1

LOAD 0
SUB 0

FETCH 2
ADD 1
SLOT 2

LOAD 0
SUB 0

FETCH 3
ADD 1
SLOT 3

; Loop back to try new nonce
; (Jump to MINING_LOOP)

; ========================================
; [PAGE 111-127: OUTPUT RESULTS]
; ========================================
SETPAGE 120

; Check success flag
FETCH 15
LOAD 1
SUB 15
